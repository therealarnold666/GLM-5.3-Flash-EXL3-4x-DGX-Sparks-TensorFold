+def short_prompt_rows(prefill_rows: int, value: str | None = None) -> int:
+    """TF_GLM_SHORT_PROMPT_ROWS: prioritize a newly admitted short prompt at a chunk boundary; 0 (default) keeps
+    FIFO/grouped prefill. The current GPU forward is never interrupted and a long prompt resumes next iteration."""
+
+    value = os.environ.get("TF_GLM_SHORT_PROMPT_ROWS", "") if value is None else value
+    value = value.strip() or "0"
+    rows = int(value) if value.isdecimal() else -1
+    if rows < 0 or rows > prefill_rows:
+        raise ValueError(f"TF_GLM_SHORT_PROMPT_ROWS: 0 to {prefill_rows}, not {value!r}")
+    return rows
+
