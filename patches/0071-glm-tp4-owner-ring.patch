+    def exchange_owner_ring(self, partials: torch.Tensor, owners: torch.Tensor, forward: torch.Tensor) -> None:
+        """Four-rank ring: deliver only each rank's FP32 partials of its owned prompt rows.
+
+        ``partials[dest]`` is this rank's contribution to destination ``dest``;
+        ``owners[src]`` receives source ``src``'s contribution to this rank.
+        The opposite-rank block travels clockwise through one direct neighbor.
+        Every NCCL peer in both groups is physically adjacent on 0-1-2-3-0.
+        ``owners[self.rank]`` is left for the caller to fill with its own block.
+        """
+
+        if self.world != 4 or partials.ndim != 3 or owners.shape != partials.shape:
+            raise ValueError("exchange_owner_ring needs matching [4, rows, width] tensors on four ranks")
+        if partials.dtype != torch.float32 or owners.dtype != torch.float32 or forward.shape != partials.shape[1:]:
+            raise ValueError("exchange_owner_ring needs FP32 owner blocks and one forwarding block")
+        if not (partials.is_contiguous() and owners.is_contiguous() and forward.is_contiguous()):
+            raise ValueError("exchange_owner_ring needs contiguous tensors")
+        prev, nxt, opp = (self.rank - 1) % 4, (self.rank + 1) % 4, (self.rank + 2) % 4
+        count = partials[0].numel()
+        stream = torch.cuda.current_stream().cuda_stream
+        dtype = _DTYPES[torch.float32]
+        lib = self.lib
+
+        def send(t: torch.Tensor, peer: int) -> None:
+            self._check(lib.ncclSend(t.data_ptr(), count, dtype, peer, self.comm, stream))
+
+        def recv(t: torch.Tensor, peer: int) -> None:
+            self._check(lib.ncclRecv(t.data_ptr(), count, dtype, peer, self.comm, stream))
+
+        self._check(lib.ncclGroupStart())
+        try:
+            send(partials[nxt], nxt)
+            send(partials[opp], nxt)
+            recv(owners[prev], prev)
+            recv(forward, prev)
+            send(partials[prev], prev)
+            recv(owners[nxt], nxt)
+        finally:
+            self._check(lib.ncclGroupEnd())
+        self._check(lib.ncclGroupStart())
+        try:
+            send(forward, nxt)
+            recv(owners[opp], prev)
+        finally:
+            self._check(lib.ncclGroupEnd())
+
     def barrier(self) -> None:
         x = torch.zeros((1,), dtype=torch.float32, device="cuda")
         y = torch.zeros((self.world,), dtype=torch.float32, device="cuda")
